const cache="love-guide-v1";

const files=[
"index.html",
"ai-love.html",
"manifest.json"
];


self.addEventListener("install",e=>{

e.waitUntil(

caches.open(cache)
.then(c=>c.addAll(files))

);

});


self.addEventListener("fetch",e=>{

e.respondWith(

caches.match(e.request)
.then(r=>r||fetch(e.request))

);

});